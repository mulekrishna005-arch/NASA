{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Full-Stack NASA App",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/run.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Retrain ML Pipeline (NumPy Engine)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/backend/model_pipeline.py"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Sync Live NASA FIRMS Telemetry (NOAA-21)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/backend/model_pipeline.py",
        "--sensor", "VIIRS_NOAA21_NRT",
        "--save"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
